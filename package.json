{
  "name": "potree",
  "private": true,
  "version": "1.8.0",
  "description": "WebGL point cloud viewer",
  "keywords": [
    "point",
    "cloud",
    "pointcloud",
    "octree",
    "entwine",
    "viewer",
    "threejs",
    "webgl",
    "browser",
    "tool"
  ],
  "main": "./build/potree/potree.js",
  "scripts": {
    "dev": "vite build --watch",
    "build:lib": "vite build",
    "build:workers": "node scripts/build-esm-workers.mjs",
    "build:concat-workers": "node scripts/build-workers.mjs",
    "build:pages": "node scripts/generate-pages.mjs",
    "typecheck": "tsc --noEmit",
    "build:vite": "npm run build:lib && npm run build:workers && npm run build:concat-workers && npm run build:pages",
    "start": "npm run dev",
    "build": "npm run build:vite",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "json5": "^2.1.3",
    "vite": "^5.4.21",
    "vite-plugin-static-copy": "^1.0.6"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Markus Schütz",
  "license": "BSD-2-CLAUSE",
  "devDependencies": {
    "@types/jquery": "^4.0.1",
    "@types/three": "^0.125.3",
    "typescript": "^5.9.3"
  }
}
