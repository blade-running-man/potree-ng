{
  "name": "potree",
  "private": true,
  "version": "1.8.0",
  "description": "WebGL point cloud viewer",
  "keywords": [
    "point",
    "cloud",
    "pointcloud",
    "octree",
    "entwine",
    "viewer",
    "threejs",
    "webgl",
    "browser",
    "tool"
  ],
  "main": "./build/potree/potree.js",
  "scripts": {
    "dev": "vite build --watch",
    "build:lib": "vite build",
    "build:workers": "node scripts/build-esm-workers.mjs",
    "build:concat-workers": "node scripts/build-workers.mjs",
    "build:pages": "node scripts/generate-pages.mjs",
    "build:three": "node scripts/copy-three.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:build": "npm run build && playwright test",
    "test:e2e:report": "playwright show-report",
    "build:vite": "npm run build:three && npm run build:lib && npm run build:workers && npm run build:concat-workers && npm run build:pages",
    "start": "npm run dev",
    "build": "npm run build:vite",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "json5": "^2.1.3",
    "three": "^0.185.0",
    "vite": "^8.2.1",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Markus Schütz",
  "license": "BSD-2-CLAUSE",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jquery": "^4.0.1",
    "@types/three": "^0.185.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
